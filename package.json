{
  "name": "crease-tasks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5197 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4190 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "doctor": "creaseui-lint doctor",
    "check": "tsc --noEmit && eslint src --max-warnings 0 && creaseui-lint doctor && creaseui-lint css && node scripts/check-lint-fixtures.mjs && vitest run",
    "scope": "creaseui-lint scope --baseline HEAD",
    "test": "vitest run",
    "check:lint-fixtures": "node scripts/check-lint-fixtures.mjs",
    "check:browser": "node scripts/check-browser.mjs"
  },
  "dependencies": {
    "@effect/platform-browser": "4.0.0-rc.117",
    "@foldkit/ui": "0.164.0",
    "@fontsource-variable/inter": "5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "4.0.0-rc.117",
    "foldkit": "0.164.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@creaseui/lint": "file:vendor/creaseui-lint-0.1.0.tgz",
    "@foldkit/vite-plugin": "0.25.0",
    "@tailwindcss/vite": "4.3.1",
    "eslint": "10.8.0",
    "playwright": "^1.62.1",
    "tailwindcss": "4.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.0.16",
    "vitest": "^5.0.5"
  }
}
